# --- General ---
AI_CORE_PROJECTS_FILE=projects.json
AI_CORE_DATA_DIR=data

# --- Embedding ---
AI_CORE_EMBEDDING_DIM=768
AI_CORE_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- Reranker ---
AI_CORE_USE_CROSS_ENCODER=true
AI_CORE_RERANKER_MODEL=BAAI/bge-reranker-base
AI_CORE_RERANKER_TOP_K=10

# --- Graph Pruning ---
AI_CORE_GRAPH_MAX_DEPTH=2
AI_CORE_GRAPH_MAX_NODES=50
AI_CORE_GRAPH_INCLUDE_TESTS=false
