MCP_PORT=3000
MCP_HOST=0.0.0.0

# Docker: mcp-server container talks to engine by service name.
# MCP bridge on your machine uses http://localhost:3000 (see config/cursor-mcp.json).
ENGINE_HOST=http://intelligence-engine:8000
ENGINE_PORT=8000

LANCEDB_PATH=./data/lancedb
GRAPH_PATH=./data/graph
INDEX_PATH=./data/indexes

# Embedding: có OPENAI_API_KEY → dùng OpenAI online. Không có → fallback Ollama local.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Ollama local (fallback khi không có API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

TASK_QUEUE_PROVIDER=rq
REDIS_URL=redis://localhost:6379/0
INDEXING_JOB_TIMEOUT=3600
RQ_SIMPLE_WORKER=true

TELEMETRY_ENABLED=true
TELEMETRY_PROVIDER=local
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

LOG_LEVEL=INFO
WATCH_INTERVAL=3
WATCHER_ENABLED=true

# Hybrid search tuning
SEARCH_CANDIDATE_MULTIPLIER=4
SEARCH_RRF_K=60
SEARCH_GRAPH_BOOST=0.15
