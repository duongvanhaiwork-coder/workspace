# Copy to docker-compose.override.yml when app repos live OUTSIDE ./projects/
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   # Edit paths below to match your machine, then: docker compose up -d
#
# projects.json path must match mount target (/workspace/projects/<name>).

services:
  intelligence-engine:
    volumes:
      - /absolute/path/to/my-api:/workspace/projects/my-api:ro

  intelligence-worker:
    volumes:
      - /absolute/path/to/my-api:/workspace/projects/my-api:ro
